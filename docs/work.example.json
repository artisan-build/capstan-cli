{
  "version": 2,
  "launcher": "solo",
  "capstan_url": "https://capstan.example.com",
  "team": "example-team",
  "actor_id": "123",
  "credential_file": "credentials/work-drain",
  "max_concurrent": 2,
  "orchestrator_capacity": 1,
  "max_load_1m": 6,
  "max_memory_percent": 85,
  "capabilities": ["git"],
  "roles": ["builder", "orchestrator"],
  "role_providers": {
    "builder": "opencode",
    "orchestrator": "claude"
  },
  "state_file": "var/work-state.json",
  "work_dir": "var/work-items",
  "lock_file": "var/work.lock",
  "prompt_template": "work-prompt.md",
  "orchestrator_prompt_template": "orchestrator-prompt.md",
  "solo_mcp_path": "/Applications/Solo.app/Contents/MacOS/mcp",
  "solo_call_timeout_seconds": 30,
  "solo_ready_timeout_seconds": 120,
  "solo_bindings": {
    "builder": {
      "project_id": 12,
      "agent_tool_id": 34,
      "harness": "opencode",
      "extra_args": []
    },
    "orchestrator": {
      "project_id": 12,
      "agent_tool_id": 35,
      "harness": "claude",
      "extra_args": []
    }
  },
  "request_timeout_seconds": 15
}
