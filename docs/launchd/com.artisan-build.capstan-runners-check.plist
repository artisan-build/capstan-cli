<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.artisan-build.capstan-runners-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/capstan</string>
        <string>runners</string>
        <string>check</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/capstan-runners-check.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/capstan-runners-check.stderr.log</string>
</dict>
</plist>
